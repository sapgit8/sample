TRUNCATE TABLE airports;
INSERT INTO airports (airport_iata, airport_icao, airport_name, municipality, country_code, latitude, longitude)
SELECT DISTINCT ON (airport_iata) airport_iata, airport_icao, airport_name, municipality, country_code, latitude::numeric, longitude::numeric
FROM airports_staging
WHERE airport_iata IS NOT NULL AND trim(airport_iata) != ''
ORDER BY airport_iata;
